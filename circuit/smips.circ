    <comp lib="7" loc="(2860,800)" name="Text">
      <a name="font" val="SansSerif bold 30"/>
      <a name="text" val="Esto define cuando escribir en un registro"/>
    </comp>
    <comp lib="7" loc="(2930,820)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="En los registros solo se escribe si no estoy en un estado de decode o fetch"/>
    </comp>
    <comp lib="7" loc="(2935,835)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="y estoy haciendo operaciones, R, I sobre los registros o estoy en un jal state"/>
    </comp>
    <comp lib="7" loc="(2955,130)" name="Text">
      <a name="font" val="SansSerif bold 18"/>
      <a name="text" val="Define en que estados se escribe en el PC"/>
    </comp>
    <comp lib="7" loc="(3010,2180)" name="Text">
      <a name="font" val="SansSerif bold 18"/>
      <a name="text" val="Estos son triviales, me pesa XD"/>
    </comp>
    <comp lib="7" loc="(3035,1930)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="En dependencia de la instruccion se selecciona en que registro (RS,RT,RD) guardar los datos"/>
    </comp>
    <comp lib="7" loc="(3060,555)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="Este pin es para saber desde donde voy a utilizar los valores de A y B para la ALU"/>
    </comp>
    <comp lib="7" loc="(3080,1640)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="En estos estados se debe hacer una suma con los valores A y B seleccionados"/>
    </comp>
    <comp lib="7" loc="(3085,1165)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="text" val="Este pin es para seleccionar la direccion de memoria"/>
    </comp>
    <comp lib="7" loc="(3120,1425)" name="Text">
      <a name="font" val="SansSerif bold 18"/>
      <a name="text" val="Seleccionar para guardar el dato en el RF "/>
    </comp>
    <comp lib="7" loc="(3165,425)" name="Text">
